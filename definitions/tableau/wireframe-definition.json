{
  "id": "default",
  "kind": "tableau",
  "name": "Default Tableau design guidelines",
  "version": 1,
  "grid": {
    "cols": 12,
    "rows": 8,
    "comment": "All components snap to this grid. x/y are zero-based cell coordinates; w/h are spans in cells."
  },
  "components": [
    { "type": "title", "label": "Dashboard title", "min_w": 6, "min_h": 1, "max_per_dashboard": 1, "props": ["text"] },
    { "type": "kpi", "label": "KPI / BAN", "min_w": 2, "min_h": 1, "props": ["metric", "comparison"] },
    { "type": "bar", "label": "Bar chart", "min_w": 3, "min_h": 2, "props": ["measure", "dimension", "orientation"] },
    { "type": "line", "label": "Line / trend chart", "min_w": 4, "min_h": 2, "props": ["measure", "date_dimension"] },
    { "type": "area", "label": "Area chart", "min_w": 4, "min_h": 2, "props": ["measure", "date_dimension"] },
    { "type": "scatter", "label": "Scatter plot", "min_w": 3, "min_h": 2, "props": ["measure_x", "measure_y", "dimension"] },
    { "type": "table", "label": "Table / crosstab", "min_w": 4, "min_h": 2, "props": ["columns"] },
    { "type": "map", "label": "Map", "min_w": 4, "min_h": 3, "props": ["geo_dimension", "measure"] },
    { "type": "filter", "label": "Filter control", "min_w": 2, "min_h": 1, "props": ["field", "control_type"] },
    { "type": "legend", "label": "Legend", "min_w": 2, "min_h": 1, "props": [] },
    { "type": "text", "label": "Text / annotation", "min_w": 2, "min_h": 1, "props": ["text"] },
    { "type": "container", "label": "Layout container", "min_w": 4, "min_h": 2, "props": ["direction"] }
  ],
  "rules": [
    {
      "id": "title_required",
      "severity": "error",
      "description": "Every dashboard has exactly one title component, placed in the top row (y = 0)."
    },
    {
      "id": "filters_edge",
      "severity": "warning",
      "description": "Filter controls sit in the top band (y <= 1) or the right-hand column band (x >= cols - 3); scattered filters confuse users."
    },
    {
      "id": "kpi_band_top",
      "severity": "warning",
      "description": "KPI components belong in the upper third of the dashboard (y <= 2) — headline numbers before detail."
    },
    {
      "id": "no_overlap",
      "severity": "error",
      "description": "Components must not overlap."
    },
    {
      "id": "on_grid",
      "severity": "error",
      "description": "Components must lie fully inside the grid."
    },
    {
      "id": "min_size",
      "severity": "error",
      "description": "Components must meet their type's minimum width/height so the rendered view stays legible."
    },
    {
      "id": "max_components",
      "severity": "warning",
      "threshold": 12,
      "description": "More than 12 components on one dashboard is cognitive overload; split into multiple dashboards."
    },
    {
      "id": "chart_needs_title",
      "severity": "warning",
      "description": "Every chart-class component (bar, line, area, scatter, table, map) carries a non-empty title."
    }
  ]
}
